# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
ADMIN_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Text AI
TEXT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Image AI
IMAGE_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=dall-e-3

# Optional topic research
TOPIC_SEARCH_PROVIDER=
TOPIC_SEARCH_API_KEY=

# Meta / Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/callback
THREADS_API_VERSION=v1.0
THREADS_USER_ID=

# Token encryption (32 bytes hex or random string)
TOKEN_ENCRYPTION_KEY=

# Worker security
CRON_SECRET=
